# Base URL of the CampusStay API as called by the browser.
# Leave this empty so the browser calls this Next.js app, which proxies /api to the backend.
# That keeps the session cookie on this site. A direct example is http://localhost:4000
NEXT_PUBLIC_API_URL=

# Server-side origin the Next.js rewrite uses to reach the API. Not exposed to the browser.
API_PROXY_TARGET=http://localhost:4000

# Must match backend JWT_SECRET. Route protection verifies the session cookie with this value.
# The value below is for local development only.
JWT_SECRET=dev-only-change-me-before-any-shared-deployment-32
