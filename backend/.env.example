# HTTP port the API listens on.
PORT=4000

# MongoDB Atlas connection string. Keep the real username and password out of git.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/campusstay?retryWrites=true&w=majority

# Secret used to sign session JWTs. Use at least 32 random characters.
# The value below is for local development only. Production startup rejects it.
JWT_SECRET=dev-only-change-me-before-any-shared-deployment-32

# Lifetime of a session token. Keep it short. Examples: 15m, 1h, 12h, 1d.
JWT_EXPIRES_IN=15m

# Browser origin allowed by CORS. It must match the frontend URL exactly, including the port.
CLIENT_URL=http://localhost:3000

# M-Pesa target. Use sandbox while developing and production only for a live shortcode.
MPESA_ENV=sandbox

# Daraja app consumer key from the Safaricom developer portal.
MPESA_CONSUMER_KEY=

# Daraja app consumer secret from the Safaricom developer portal.
MPESA_CONSUMER_SECRET=

# Lipa Na M-Pesa online shortcode. The sandbox shortcode is usually 174379.
MPESA_SHORTCODE=174379

# Lipa Na M-Pesa online passkey from the Daraja portal.
MPESA_PASSKEY=

# Public HTTPS URL Safaricom calls after an STK push. Localhost is not reachable by Safaricom.
MPESA_CALLBACK_URL=http://localhost:4000/api/v1/mpesa/callback

# Organization name printed on admin reports.
ORG_NAME=CampusStay

# Absolute URL of the organization logo printed on admin reports.
ORG_LOGO_URL=http://localhost:3000/logo.svg
